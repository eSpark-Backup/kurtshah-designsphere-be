<Window x:Class="Revit.WPFUI.Components.UI.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check Your Browser" Height="350" Width="400">
    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold" Margin="10" TextAlignment="Center">
                Check Your Browser
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Center">
                A browser window has been opened for you to log into your DesignSphere Account.
                Once you've logged in, you'll be brought back to this page.
            </TextBlock>
            <TextBlock Margin="10" TextWrapping="Wrap" TextAlignment="Center">
                If you prefer not to sign-in, you can close this popup and continue.
                If you can't find a browser window, use the "Restart sign-in" button.
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Width="100" Margin="5" Content="Close" Click="CloseButton_Click" />
                <Button Width="150" Margin="5" Content="Restart Sign-In" Click="RestartButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
