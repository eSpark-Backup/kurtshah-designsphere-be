; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Revit"
#define MyAppVersion "1.0"
#define MyAppPublisher "DesignSpher, Inc."
#define MyAppURL "http://www.example.com/"

[Code]
function GetRevitAddinPath(Param: String): String;
var
  RevitVersion: String;
begin
  // Get the environment variable REVIT_VERSION
  RevitVersion := GetEnv('REVIT_VERSION');

  // If not found, use a default version (optional)
  if RevitVersion = '' then
    RevitVersion := '2025'; // Default to 2025 if not set

  // Construct the Revit Addins folder path
  Result := 'C:\ProgramData\Autodesk\Revit\Addins\' + RevitVersion;

  // Debugging message to confirm the correct path
  MsgBox('Installing to: ' + Result, mbInformation, MB_OK);
end;

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{009967C0-96B5-4886-A431-55B6F9551572}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputDir=C:\otherproject\eSpark-Consultants\kurtshah-designsphere-be\Src\Plugins\Revit.Installer\Output
OutputBaseFilename=revit
SetupIconFile=C:\otherproject\eSpark-Consultants\kurtshah-designsphere-be\Src\Plugins\Revit.Installer\assets\revit.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

