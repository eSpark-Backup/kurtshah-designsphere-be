{
  "ConnectionStrings": {
    "ConfigurationDbConnection": "Server=db;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "PersistedGrantDbConnection": "Server=db;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "IdentityDbConnection": "Server=db;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "AdminLogDbConnection": "Server=db;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "AdminAuditLogDbConnection": "Server=db;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "DataProtectionDbConnection": "Server=db;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;"
  },
  "AdminApiConfiguration": {
    "ApiName": "designsphere_identity Api",
    "ApiVersion": "v1",
    "ApiBaseUrl": "https://admin-api.skoruba.local",
    "IdentityServerBaseUrl": "https://sts.skoruba.local",
    "OidcSwaggerUIClientId": "adminclient_api_swaggerui",
    "OidcApiName": "adminclient_api",
    "AdministrationRole": "adminrole",
    "RequireHttpsMetadata": false,
    "CorsAllowAnyOrigin": true,
    "CorsAllowOrigins": []
  },
  "SmtpConfiguration": {
    "Host": "",
    "Login": "",
    "Password": ""
  },
  "SendGridConfiguration": {
    "ApiKey": "",
    "SourceEmail": "",
    "SourceName": ""
  },
  "DatabaseProviderConfiguration": {
    "ProviderType": "PostgreSQL"
  },
  "AuditLoggingConfiguration": {
    "Source": "IdentityServer.Admin.Api",
    "SubjectIdentifierClaim": "sub",
    "SubjectNameClaim": "name",
    "ClientIdClaim": "client_id"
  },
  "IdentityOptions": {
    "Password": {
      "RequiredLength": 8
    },
    "User": {
      "RequireUniqueEmail": false
    },
    "SignIn": {
      "RequireConfirmedAccount": false
    }
  },
  "DataProtectionConfiguration": {
    "ProtectKeysWithAzureKeyVault": false
  },
  "AzureKeyVaultConfiguration": {
    "AzureKeyVaultEndpoint": "",
    "ClientId": "",
    "ClientSecret": "",
    "TenantId": "",
    "UseClientCredentials": true,
    "DataProtectionKeyIdentifier": "",
    "ReadConfigurationFromKeyVault": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        //"Microsoft": "Warning", hanging issue
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:9000",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Identity.Admin.Api"
    }
  }
}