    "IsDurable": true,
    "AutoDelete": false
  },
  "SMSConfig": {
    "Secret": "SMSSECRET",
    "ServerAddress": "http://localhost:9001"
  },
  "OTPConfig": {
    "Secret": "SMSSECRET",
    "Validity": 180,
    "Retries": 10
  },
  "EmailConfig": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "SenderEmail": ""
  },
  "DatabaseProviderConfiguration": {
    "ProviderType": "PostgreSQL"
  },
  "SocialLogin": {
    "Google": {
      "ClientId": "123456"
    },
    "Apple": {
      "ClientId": "ds.pro",
      "KeyUrl": "https://appleid.apple.com/auth/keys",
      "IssuerUrl": "https://appleid.apple.com"
    },
    "Facebook": {
      "ClientId": "123456",
      "ClientSecret": "123456",
      "AppId": "123456"
    }
  },
  "CertificateConfiguration": {
    "UseTemporarySigningKeyForDevelopment": true,

    "CertificateStoreLocation": "LocalMachine",
    "CertificateValidOnly": true,

    "UseSigningCertificateThumbprint": false,
    "SigningCertificateThumbprint": "",

    "UseSigningCertificatePfxFile": false,
    "SigningCertificatePfxFilePath": "",
