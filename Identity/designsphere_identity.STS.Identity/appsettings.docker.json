{
  //"Urls": "https://*:44310",
  "ConnectionStrings": {
    "ConfigurationDbConnection": "Server=host.docker.internal;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "PersistedGrantDbConnection": "Server=host.docker.internal;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "IdentityDbConnection": "Server=host.docker.internal;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;",
    "DataProtectionDbConnection": "Server=host.docker.internal;Port=5432;Database=ds_identity;User Id=admin;Password=admin1234;"
  },
  "EventBusSettings": {
    "HostAddress": "amqp://admin:dev@host.docker.internal:5672",
    "DefaultConsumerBatchSize": 500,
    "ConcurrencyLimit": 2,
    "UseMessageRetry": 5,
    "IsDurable": true,
    "AutoDelete": false
  },
  "SMSConfig": {
    "Secret": "SMSSECRET",
    "ServerAddress": "http://host.docker.internal:9001"
  },
  "AdminConfiguration": {
    "PageTitle": "Designsphere Identity",
    "HomePageLogoUri": "~/images/skoruba-icon.png",
    "FaviconUri": "~/favicon.ico",
    "Theme": null,
    "CustomThemeCss": null,
    "IdentityAdminBaseUrl": "https://host.docker.internal:44303",
    "IdentityServerBaseUrl": "https://host.docker.internal:44310",
    "AdministrationRole": "adminrole"
  },
  "AppSettings": {
    "ProfilePicturePath": "wwwroot/ProfilePictures",
    "VerificationUrl": "https://host.docker.internal:44310",
    "ResetPasswordUrl": "https://host.docker.internal:44310"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        //"Microsoft": "Warning", hanging issue
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://host.docker.internal:9000",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
    }
  }
}